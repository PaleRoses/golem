      {"id": "front:spine_lower/tail", "scope": ["landmark:spine_lower/tail@front"], "metric": "schematic_offset", "operator": "maximum", "value": 0.01, "unit": "world_unit", "tolerance": 0, "knob": "skeleton/spine_lower@rest_dir", "direction": "-"},
      {"id": "front:spine_upper/tail", "scope": ["landmark:spine_upper/tail@front"], "metric": "schematic_offset", "operator": "maximum", "value": 0.01, "unit": "world_unit", "tolerance": 0, "knob": "skeleton/spine_upper@rest_dir", "direction": "-"},
      {"id": "front:neck/tail", "scope": ["landmark:neck/tail@front"], "metric": "schematic_offset", "operator": "maximum", "value": 0.01, "unit": "world_unit", "tolerance": 0, "knob": "skeleton/neck@rest_dir", "direction": "-"},
