{
  "name": "obsidian-knight-underbody",
  "note": "Pose schematic for the canonical separated underbody in knight_body.json. Armor and sword are assembly elements and therefore have no body landmark here. Front uses (world x, world y); side uses (world z, world y). Targets are the accepted authored pose rounded to three decimals.",
  "schematic": {
    "front": {
      "pelvis/head": [0.0, 0.43],
      "spine_lower/tail": [0.0, 0.95],
      "spine_upper/tail": [0.0, 1.19],
      "neck/tail": [0.0, 1.359],
      "helm/tail": [0.0, 1.579],
      "clavicle/tail": [0.255, 1.127],
      "upper_arm/tail": [0.305, 0.825],
      "forearm/tail": [0.106, 0.558],
      "thigh/tail": [0.194, -0.164],
      "shin/tail": [0.205, -0.744],
      "foot/tail": [0.205, -0.746]
    },
    "side": {
      "pelvis/head": [0.0, 0.43],
      "spine_lower/tail": [0.021, 0.95],
      "spine_upper/tail": [0.026, 1.19],
      "neck/tail": [0.032, 1.359],
      "helm/tail": [0.037, 1.579],
      "clavicle/tail": [0.024, 1.127],
      "upper_arm/tail": [0.074, 0.825],
